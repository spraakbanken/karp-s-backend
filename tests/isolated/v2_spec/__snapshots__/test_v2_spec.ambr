              'in': 'query',
              'name': 'resources',
              'required': True,
              'schema': dict({
                'anyOf': list([
                  dict({
                    'minLength': 1,
                    'pattern': '^[^,]+(,[^,]+)*$',
                    'type': 'string',
                  }),
