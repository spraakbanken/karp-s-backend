                ]),
                'description': 'The query. See https://ws.spraakbanken.gu.se/docs/karp for a description of the query language, however, Karp-s does not support sub-queries, exists, missing and freetext.',
                'title': 'Query',
              }),
            }),
            dict({
              'in': 'query',
              'name': 'size',
              'required': False,
              'schema': dict({
                'default': 10,
                'title': 'Size',
                'type': 'integer',
              }),
            }),
            dict({
              'in': 'query',
              'name': 'from',
              'required': False,
              'schema': dict({
